{
  "openapi": "3.0.1",
  "info": {
    "title": "Daney API V2",
    "version": "v2.0"
  },
  "paths": {
    "/api/v2.0/auth/validate-token": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "validateToken",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "security": [
          {
            "bearerAuth": [
              "bearerAuth"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "JWT Authorization header using the Bearer scheme.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}